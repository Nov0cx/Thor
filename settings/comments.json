{
    "odin":      { "line": "//", "block": ["/*", "*/"], "quotes": "\"`", "extensions": [".odin"] },
    "c":         { "line": "//", "block": ["/*", "*/"], "quotes": "\"", "extensions": [".c", ".h"] },
    "cpp":       { "line": "//", "block": ["/*", "*/"], "quotes": "\"", "extensions": [".cpp", ".cc", ".cxx", ".c++", ".hpp", ".hh", ".hxx", ".h++", ".ipp"] },
    "rust":      { "line": "//", "block": ["/*", "*/"], "quotes": "\"", "extensions": [".rs"] },
    "go":        { "line": "//", "block": ["/*", "*/"], "quotes": "\"`", "extensions": [".go"] },
    "javascript":{ "line": "//", "block": ["/*", "*/"], "extensions": [".js", ".jsx", ".mjs", ".cjs", ".ts", ".mts", ".cts", ".tsx"] },
    "zig":       { "line": "//", "quotes": "\"", "extensions": [".zig"] },
    "glsl":      { "line": "//", "block": ["/*", "*/"], "quotes": "\"", "extensions": [".glsl", ".vert", ".frag"] },
    "slang":     { "line": "//", "block": ["/*", "*/"], "quotes": "\"", "extensions": [".slang", ".slangh"] },
    "python":    { "line": "#", "quotes": "\"'", "extensions": [".py"] },
    "shell":     { "line": "#", "extensions": [".sh"] },
    "toml":      { "line": "#", "quotes": "\"'", "extensions": [".toml"] },
    "cmake":     { "line": "#", "block": ["#[[", "]]"], "quotes": "\"", "extensions": [".cmake", "CMakeLists.txt"] },
    "make":      { "line": "#", "extensions": [".mk", ".mak", "Makefile", "GNUmakefile"] },
    "yaml":      { "line": "#", "quotes": "\"'", "extensions": [".yml", ".yaml"] },
    "git":       { "line": "#", "extensions": [".gitignore", ".gitmodules"] },
    "ini":       { "line": ";", "quotes": "\"", "extensions": [".ini", ".cfg"] },
    "batch":     { "line": "::", "quotes": "\"", "extensions": [".bat"] },
    "lua":       { "line": "--", "block": ["--[[", "]]"], "quotes": "\"'", "extensions": [".lua"] },
    "jai":       { "line": "//", "block": ["/*", "*/"], "quotes": "\"", "extensions": [".jai"] },
    "java":      { "line": "//", "block": ["/*", "*/"], "quotes": "\"", "extensions": [".java"] },
    "kotlin":    { "line": "//", "block": ["/*", "*/"], "quotes": "\"", "extensions": [".kt"] },
    "csharp":    { "line": "//", "block": ["/*", "*/"], "quotes": "\"", "extensions": [".cs"] },
    "php":       { "line": "//", "block": ["/*", "*/"], "quotes": "\"'", "extensions": [".php"] },
    "css":       { "block": ["/*", "*/"], "quotes": "\"'", "extensions": [".css"] },
    "html":      { "block": ["<!--", "-->"], "quotes": "\"'", "extensions": [".html", ".htm", ".xml", ".svg"] },
    "markdown":  { "block": ["<!--", "-->"], "quotes": "\"", "extensions": [".md"] },
    "haskell":   { "line": "--", "block": ["{-", "-}"], "quotes": "\"", "extensions": [".hs"] },
    "ocaml":     { "block": ["(*", "*)"], "quotes": "\"", "extensions": [".ml", ".mli"] },
    "ruby":      { "line": "#", "quotes": "\"'", "extensions": [".rb"] }
}
