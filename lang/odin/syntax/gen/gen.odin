// The generator behind `build.odin gen_syntax`: reads syntax.schema and writes the node kinds and
// the typed views of package odinsyntax.
package syntaxgen

import "core:fmt"
import "core:slice"
import "core:strings"

SCHEMA_PATH :: "lang/odin/syntax/syntax.schema"
TOKEN_PATH :: "lang/odin/syntax/token.odin"
KIND_PATH :: "lang/odin/syntax/kind.odin"
VIEWS_PATH :: "lang/odin/syntax/views.odin"
TABLE_PATH :: "lang/odin/syntax/views_table_test.odin"

HEADER :: "// Generated by `odin run build.odin -file -- gen_syntax` from syntax.schema. Do not edit.\n"

// The text of the three generated files.
Output :: struct {
    kinds: string,
    views: string,
    table: string,
}

Rule :: enum {
    Node,
    Nodes,
    Token,
    Custom,
}

Accessor :: struct {
    name:     string,
    required: bool,
    rule:     Rule,
    targets:  []string, // kinds and categories, or token kinds
    after:    []string,
    before:   []string,
    last:     bool,
    doc:      string,
    line:     int,
}

Kind :: struct {
    name:       string,
    categories: []string,
    doc:        string,
    accessors:  [dynamic]Accessor,
    view:       bool,
}

Schema :: struct {
    kinds:        [dynamic]Kind,
    token_groups: map[string][]string,
}

// Generates the files from `schema` and the source of token.odin. All memory is from `allocator`.
generate :: proc(schema_src, token_src: string, allocator := context.allocator) -> (out: Output, errors: []string) {
    context.allocator = allocator
    errs := make([dynamic]string)
    tokens := token_kinds(token_src)
    if len(tokens) == 0 {
        append(&errs, "token.odin: no Token_Kind enum")
        return {}, errs[:]
    }
    s := parse_schema(schema_src, &errs)
    check_schema(&s, tokens, &errs)
    if len(errs) > 0 {
        return {}, errs[:]
    }
    out.kinds = write_kinds(&s)
    out.views = write_views(&s)
    out.table = write_table(&s)
    return out, nil
}

// The member names of `Token_Kind` in token.odin.
token_kinds :: proc(src: string) -> []string {
    start := strings.index(src, "Token_Kind :: enum")
    if start < 0 {
        return nil
    }
    body := src[start:]
    open := strings.index_byte(body, '{')
    close := strings.index_byte(body, '}')
    if open < 0 || close < open {
        return nil
    }
    out := make([dynamic]string)
    for line in strings.split_lines(body[open + 1:close]) {
        text := strings.trim_space(line)
        if cut := strings.index(text, "//"); cut >= 0 {
            text = strings.trim_space(text[:cut])
        }
        text = strings.trim_right(text, ",")
        if text != "" {
            append(&out, text)
        }
    }
    return out[:]
}

parse_schema :: proc(src: string, errs: ^[dynamic]string) -> (s: Schema) {
    s.token_groups = make(map[string][]string)
    lines := strings.split_lines(src)
    for raw, i in lines {
        line_no := i + 1
        line := strings.trim_right_space(raw)
        if trimmed := strings.trim_space(line); trimmed == "" || trimmed[0] == '#' {
            continue
        }
        doc := ""
        if cut := strings.index(line, "//"); cut >= 0 {
            doc = strings.trim_space(line[cut + 2:])
            line = strings.trim_right_space(line[:cut])
        }
        indented := line[0] == ' '
        line = strings.trim_space(line)
        if strings.has_prefix(line, "tokens ") {
            name, toks, ok := split_definition(line[len("tokens "):])
            if !ok {
                append(errs, fmt.aprintf("syntax.schema:%d: expected `tokens name = Kind ...`", line_no))
                continue
            }
            s.token_groups[name] = toks
            continue
        }
        if !indented {
            k := Kind{doc = doc, accessors = make([dynamic]Accessor), view = true}
            name, _, rest := strings.partition(line, ":")
            k.name = strings.trim_space(name)
            k.categories = strings.fields(rest)
            if strings.has_prefix(k.name, "-") {
                k.name = strings.trim_space(k.name[1:])
                k.view = false
            }
            append(&s.kinds, k)
            continue
        }
        if len(s.kinds) == 0 {
            append(errs, fmt.aprintf("syntax.schema:%d: accessor before any kind", line_no))
            continue
        }
        a, ok := parse_accessor(line, line_no, errs)
        if ok {
            a.doc = doc
            append(&s.kinds[len(s.kinds) - 1].accessors, a)
        }
    }
    return
}

split_definition :: proc(text: string) -> (name: string, items: []string, ok: bool) {
    left, eq, right := strings.partition(text, "=")
    if eq == "" {
        return "", nil, false
    }
    name = strings.trim_space(left)
    items = strings.fields(right)
    return name, items, name != "" && len(items) > 0
}

parse_accessor :: proc(line: string, line_no: int, errs: ^[dynamic]string) -> (a: Accessor, ok: bool) {
    a.line = line_no
    name, items, defined := split_definition(line)
    if !defined {
        append(errs, fmt.aprintf("syntax.schema:%d: expected `name = rule ...`", line_no))
        return {}, false
    }
    if strings.has_suffix(name, "!") {
        a.required = true
        name = name[:len(name) - 1]
    }
    a.name = name
    switch items[0] {
    case "node":   a.rule = .Node
    case "nodes":  a.rule = .Nodes
    case "token":  a.rule = .Token
    case "custom": a.rule = .Custom
    case:
        append(errs, fmt.aprintf("syntax.schema:%d: unknown rule %q", line_no, items[0]))
        return {}, false
    }
    targets := make([dynamic]string)
    after := make([dynamic]string)
    before := make([dynamic]string)
    into := &targets
    for item in items[1:] {
        switch item {
        case "last":   a.last = true
        case "after":  into = &after
        case "before": into = &before
        case:          append(into, item)
        }
    }
    a.targets, a.after, a.before = targets[:], after[:], before[:]
    if a.rule != .Custom && len(a.targets) == 0 {
        append(errs, fmt.aprintf("syntax.schema:%d: %s has no target", line_no, a.name))
        return {}, false
    }
    return a, true
}

check_schema :: proc(s: ^Schema, tokens: []string, errs: ^[dynamic]string) {
    kind_names := make(map[string]int)
    categories := make(map[string]bool)
    for k, i in s.kinds {
        if k.name in kind_names {
            append(errs, fmt.aprintf("syntax.schema: kind %s twice", k.name))
        }
        kind_names[k.name] = i
        for c in k.categories {
            categories[c] = true
        }
    }
    if len(s.kinds) > 128 {
        append(errs, "syntax.schema: more than 128 kinds do not fit a Kind_Set")
    }
    token_set := make(map[string]bool)
    for t in tokens {
        token_set[t] = true
    }
    check_tokens :: proc(s: ^Schema, names: []string, token_set: map[string]bool, line: int, errs: ^[dynamic]string) {
        for n in names {
            if !(n in token_set) && !(n in s.token_groups) {
                append(errs, fmt.aprintf("syntax.schema:%d: unknown token %q", line, n))
            }
        }
    }
    for _, group in s.token_groups {
        check_tokens(s, group, token_set, 0, errs)
    }
    for k in s.kinds {
        seen := make(map[string]bool, context.temp_allocator)
        for a in k.accessors {
            if a.name in seen {
                append(errs, fmt.aprintf("syntax.schema:%d: %s.%s twice", a.line, k.name, a.name))
            }
            seen[a.name] = true
            if !k.view {
                append(errs, fmt.aprintf("syntax.schema:%d: %s has no view", a.line, k.name))
            }
            check_tokens(s, a.after, token_set, a.line, errs)
            check_tokens(s, a.before, token_set, a.line, errs)
            switch a.rule {
            case .Node, .Nodes:
                for t in a.targets {
                    if !(t in kind_names) && !(t in categories) {
                        append(errs, fmt.aprintf("syntax.schema:%d: unknown kind or category %q", a.line, t))
                    }
                }
            case .Token:
                check_tokens(s, a.targets, token_set, a.line, errs)
            case .Custom:
            }
        }
    }
}

// The proc-name form of a kind: Selector_Expr -> selector_expr.
snake :: proc(name: string) -> string {
    return strings.to_lower(name)
}

sorted_categories :: proc(s: ^Schema) -> []string {
    seen := make(map[string]bool, context.temp_allocator)
    out := make([dynamic]string)
    for k in s.kinds {
        for c in k.categories {
            if !(c in seen) {
                seen[c] = true
                append(&out, c)
            }
        }
    }
    slice.sort(out[:])
    return out[:]
}

write_kinds :: proc(s: ^Schema) -> string {
    sb := strings.builder_make()
    strings.write_string(&sb, "package odinsyntax\n\n")
    strings.write_string(&sb, HEADER)
    strings.write_string(&sb, "\n// The kind of a syntax node.\nSyntax_Kind :: enum u16 {\n")
    for k in s.kinds {
        if k.doc != "" {
            fmt.sbprintf(&sb, "    %s, // %s\n", k.name, k.doc)
        } else {
            fmt.sbprintf(&sb, "    %s,\n", k.name)
        }
    }
    strings.write_string(&sb, "}\n\nKind_Set :: bit_set[Syntax_Kind; u128]\n")
    for c in sorted_categories(s) {
        upper := strings.to_upper(c)
        fmt.sbprintf(&sb, "\nKINDS_%s :: Kind_Set{{", upper)
        sep := ""
        for k in s.kinds {
            if slice.contains(k.categories, c) {
                fmt.sbprintf(&sb, "%s.%s", sep, k.name)
                sep = ", "
            }
        }
        strings.write_string(&sb, "}\n")
        fmt.sbprintf(&sb, "\nkind_is_%s :: #force_inline proc \"contextless\" (kind: Syntax_Kind) -> bool {{\n    return kind in KINDS_%s\n}}\n", c, upper)
    }
    return strings.to_string(sb)
}

// The Kind_Set literal of `targets`.
kind_set :: proc(s: ^Schema, targets: []string) -> string {
    if len(targets) == 1 && !is_kind(s, targets[0]) {
        return fmt.aprintf("KINDS_%s", strings.to_upper(targets[0]))
    }
    parts := make([dynamic]string)
    sets := make([dynamic]string)
    for t in targets {
        if is_kind(s, t) {
            append(&parts, fmt.aprintf(".%s", t))
        } else {
            append(&sets, fmt.aprintf("KINDS_%s", strings.to_upper(t)))
        }
    }
    lit := fmt.aprintf("Kind_Set{{%s}}", strings.join(parts[:], ", "))
    if len(parts) == 0 {
        return strings.join(sets[:], " + ")
    }
    if len(sets) == 0 {
        return lit
    }
    return fmt.aprintf("%s + %s", lit, strings.join(sets[:], " + "))
}

// The Token_Set literal of `names`, token groups expanded.
token_set :: proc(s: ^Schema, names: []string) -> string {
    flat := make([dynamic]string)
    for n in names {
        if group, is_group := s.token_groups[n]; is_group {
            for t in group {
                append(&flat, fmt.aprintf(".%s", t))
            }
        } else {
            append(&flat, fmt.aprintf(".%s", n))
        }
    }
    return fmt.aprintf("{{%s}}", strings.join(flat[:], ", "))
}

is_kind :: proc(s: ^Schema, name: string) -> bool {
    for k in s.kinds {
        if k.name == name {
            return true
        }
    }
    return false
}

has_view :: proc(s: ^Schema, name: string) -> bool {
    for k in s.kinds {
        if k.name == name {
            return k.view
        }
    }
    return false
}

// The query literal of an accessor.
query :: proc(s: ^Schema, a: Accessor) -> string {
    fields := make([dynamic]string)
    switch a.rule {
    case .Node, .Nodes: append(&fields, fmt.aprintf("kinds = %s", kind_set(s, a.targets)))
    case .Token:        append(&fields, fmt.aprintf("tokens = %s", token_set(s, a.targets)))
    case .Custom:
    }
    if len(a.after) > 0 {
        append(&fields, fmt.aprintf("after = %s", token_set(s, a.after)))
    }
    if len(a.before) > 0 {
        append(&fields, fmt.aprintf("before = %s", token_set(s, a.before)))
    }
    if a.last {
        append(&fields, "last = true")
    }
    return fmt.aprintf("{{%s}}", strings.join(fields[:], ", "))
}

// The type an accessor returns its result as.
result_type :: proc(s: ^Schema, a: Accessor) -> string {
    switch a.rule {
    case .Node:
        if len(a.targets) == 1 && has_view(s, a.targets[0]) {
            return a.targets[0]
        }
        return "Syntax_Node"
    case .Nodes:  return "Child_Iter"
    case .Token:  return "Syntax_Token"
    case .Custom: return "Syntax_Node"
    }
    return ""
}

write_views :: proc(s: ^Schema) -> string {
    sb := strings.builder_make()
    strings.write_string(&sb, "package odinsyntax\n\n")
    strings.write_string(&sb, HEADER)
    for k in s.kinds {
        if !k.view {
            continue
        }
        name := snake(k.name)
        strings.write_byte(&sb, '\n')
        if k.doc != "" {
            fmt.sbprintf(&sb, "// %s\n", k.doc)
        }
        fmt.sbprintf(&sb, "%s :: distinct Syntax_Node\n\n", k.name)
        fmt.sbprintf(&sb, "as_%s :: #force_inline proc \"contextless\" (n: Syntax_Node) -> (%s, bool) {{\n", name, k.name)
        fmt.sbprintf(&sb, "    return %s(n), n.green != nil && n.green.kind == .%s\n}}\n", k.name, k.name)
        for a in k.accessors {
            if a.rule == .Custom {
                continue
            }
            strings.write_byte(&sb, '\n')
            if a.doc != "" {
                fmt.sbprintf(&sb, "// %s\n", a.doc)
            }
            rt := result_type(s, a)
            q := query(s, a)
            switch a.rule {
            case .Node:
                fmt.sbprintf(&sb, "%s_%s :: proc \"contextless\" (n: ^%s) -> (%s, bool) {{\n", name, a.name, k.name, rt)
                if rt == "Syntax_Node" {
                    fmt.sbprintf(&sb, "    return find_child_node((^Syntax_Node)(n), %s)\n}}\n", q)
                } else {
                    fmt.sbprintf(&sb, "    c, ok := find_child_node((^Syntax_Node)(n), %s)\n    return %s(c), ok\n}}\n", q, rt)
                }
            case .Nodes:
                fmt.sbprintf(&sb, "%s_%s :: proc \"contextless\" (n: ^%s) -> Child_Iter {{\n", name, a.name, k.name)
                fmt.sbprintf(&sb, "    return child_iter((^Syntax_Node)(n), %s)\n}}\n", q)
            case .Token:
                fmt.sbprintf(&sb, "%s_%s :: proc \"contextless\" (n: ^%s) -> (Syntax_Token, bool) {{\n", name, a.name, k.name)
                fmt.sbprintf(&sb, "    return find_child_token((^Syntax_Node)(n), %s)\n}}\n", q)
            case .Custom:
            }
        }
    }
    return strings.to_string(sb)
}

write_table :: proc(s: ^Schema) -> string {
    sb := strings.builder_make()
    strings.write_string(&sb, "package odinsyntax\n\n")
    strings.write_string(&sb, HEADER)
    strings.write_string(&sb, `
// One accessor of a view, callable on any node of its kind.
View_Accessor :: struct {
    kind:     Syntax_Kind,
    name:     string,
    required: bool, // found in every node of its kind in code the compiler accepts
    call:     proc(n: ^Syntax_Node) -> (Syntax_Element, bool),
}

VIEW_ACCESSORS := [?]View_Accessor{
`)
    for k in s.kinds {
        for a in k.accessors {
            fmt.sbprintf(&sb, "    {{.%s, %q, %v, acc_%s_%s}},\n", k.name, a.name, a.required, snake(k.name), a.name)
        }
    }
    strings.write_string(&sb, "}\n")
    for k in s.kinds {
        name := snake(k.name)
        for a in k.accessors {
            fmt.sbprintf(&sb, "\n@(private = \"file\")\nacc_%s_%s :: proc(n: ^Syntax_Node) -> (Syntax_Element, bool) {{\n", name, a.name)
            switch a.rule {
            case .Node, .Custom:
                rt := result_type(s, a)
                fmt.sbprintf(&sb, "    c, ok := %s_%s((^%s)(n))\n", name, a.name, k.name)
                if rt == "Syntax_Node" {
                    strings.write_string(&sb, "    return (c if ok else nil), ok\n}\n")
                } else {
                    strings.write_string(&sb, "    return (Syntax_Node(c) if ok else nil), ok\n}\n")
                }
            case .Nodes:
                fmt.sbprintf(&sb, "    it := %s_%s((^%s)(n))\n", name, a.name, k.name)
                strings.write_string(&sb, "    c, ok := child_iter_next(&it)\n    return (c if ok else nil), ok\n}\n")
            case .Token:
                fmt.sbprintf(&sb, "    c, ok := %s_%s((^%s)(n))\n", name, a.name, k.name)
                strings.write_string(&sb, "    return (c if ok else nil), ok\n}\n")
            }
        }
    }
    return strings.to_string(sb)
}
