package odinsyntax

// Generated by `odin run build.odin -file -- gen_syntax` from syntax.schema. Do not edit.

// The kind of a syntax node.
Syntax_Kind :: enum u16 {
    None, // no node; a parse procedure that built nothing returns it
    Root,
    Error, // tokens no rule absorbs
    File_Tag,
    Package_Decl,
    Import_Decl,
    Foreign_Import_Decl,
    Foreign_Block,
    Value_Decl,
    Attribute,
    Name_List,
    Expr_List,
    Block,
    Do_Body, // `do` and the one statement after it
    Expr_Stmt,
    Assign_Stmt,
    If_Stmt,
    When_Stmt,
    For_Stmt,
    Range_Stmt,
    Switch_Stmt,
    Type_Switch_Stmt,
    Case_Clause,
    Return_Stmt,
    Defer_Stmt,
    Branch_Stmt,
    Using_Stmt,
    Label,
    Ident,
    Literal,
    Context_Expr,
    Undef_Expr,
    Comp_Lit,
    Field_Value,
    Paren_Expr,
    Selector_Expr,
    Implicit_Selector,
    Selector_Call_Expr,
    Index_Expr,
    Matrix_Index_Expr,
    Slice_Expr,
    Deref_Expr,
    Call_Expr,
    Arg_List,
    Spread_Expr, // `..x` in an argument list
    Unary_Expr,
    Binary_Expr,
    Ternary_Expr, // `c ? x : y`
    Ternary_If_Expr,
    Ternary_When_Expr,
    Or_Else_Expr,
    Or_Return_Expr,
    Or_Branch_Expr,
    Type_Assertion,
    Cast_Expr,
    Auto_Cast_Expr,
    Proc_Lit,
    Proc_Group,
    Directive, // `#name`
    Tag_Expr, // a directive and the expression or type it applies to
    Helper_Type,
    Proc_Type,
    Param_List,
    Result_List,
    Field_List,
    Field,
    Ellipsis_Type, // `..T` of a variadic parameter
    Where_Clause,
    Struct_Type,
    Union_Type,
    Enum_Type,
    Bit_Set_Type,
    Bit_Field_Type,
    Bit_Field_Field,
    Map_Type,
    Matrix_Type,
    Array_Type,
    Dynamic_Array_Type,
    Pointer_Type,
    Multi_Pointer_Type,
    Poly_Type,
    Typeid_Type,
    Distinct_Type,
    Asm_Template,
    Asm_Group,
    Asm_Spec_List,
    Asm_Spec,
    Asm_Clobber,
    Asm_Body,
    Asm_Instruction,
    Asm_Label_Decl,
    Asm_Label,
    Asm_Directive,
    Asm_Register,
    Asm_Memory_Operand,
    Asm_Register_Group,
}

Kind_Set :: bit_set[Syntax_Kind; u128]

KINDS_DECL :: Kind_Set{.Import_Decl, .Foreign_Import_Decl, .Foreign_Block, .Value_Decl, .When_Stmt}

kind_is_decl :: #force_inline proc "contextless" (kind: Syntax_Kind) -> bool {
    return kind in KINDS_DECL
}

KINDS_EXPR :: Kind_Set{.Ident, .Literal, .Context_Expr, .Undef_Expr, .Comp_Lit, .Paren_Expr, .Selector_Expr, .Implicit_Selector, .Selector_Call_Expr, .Index_Expr, .Matrix_Index_Expr, .Slice_Expr, .Deref_Expr, .Call_Expr, .Spread_Expr, .Unary_Expr, .Binary_Expr, .Ternary_Expr, .Ternary_If_Expr, .Ternary_When_Expr, .Or_Else_Expr, .Or_Return_Expr, .Or_Branch_Expr, .Type_Assertion, .Cast_Expr, .Auto_Cast_Expr, .Proc_Lit, .Proc_Group, .Directive, .Tag_Expr, .Helper_Type, .Proc_Type, .Ellipsis_Type, .Struct_Type, .Union_Type, .Enum_Type, .Bit_Set_Type, .Bit_Field_Type, .Map_Type, .Matrix_Type, .Array_Type, .Dynamic_Array_Type, .Pointer_Type, .Multi_Pointer_Type, .Poly_Type, .Typeid_Type, .Distinct_Type, .Asm_Template, .Asm_Group}

kind_is_expr :: #force_inline proc "contextless" (kind: Syntax_Kind) -> bool {
    return kind in KINDS_EXPR
}

KINDS_SIMPLE :: Kind_Set{.Value_Decl, .Expr_Stmt, .Assign_Stmt}

kind_is_simple :: #force_inline proc "contextless" (kind: Syntax_Kind) -> bool {
    return kind in KINDS_SIMPLE
}

KINDS_STMT :: Kind_Set{.Import_Decl, .Foreign_Import_Decl, .Foreign_Block, .Value_Decl, .Block, .Expr_Stmt, .Assign_Stmt, .If_Stmt, .When_Stmt, .For_Stmt, .Range_Stmt, .Switch_Stmt, .Type_Switch_Stmt, .Return_Stmt, .Defer_Stmt, .Branch_Stmt, .Using_Stmt}

kind_is_stmt :: #force_inline proc "contextless" (kind: Syntax_Kind) -> bool {
    return kind in KINDS_STMT
}

KINDS_TYPE :: Kind_Set{.Helper_Type, .Proc_Type, .Ellipsis_Type, .Struct_Type, .Union_Type, .Enum_Type, .Bit_Set_Type, .Bit_Field_Type, .Map_Type, .Matrix_Type, .Array_Type, .Dynamic_Array_Type, .Pointer_Type, .Multi_Pointer_Type, .Poly_Type, .Typeid_Type, .Distinct_Type}

kind_is_type :: #force_inline proc "contextless" (kind: Syntax_Kind) -> bool {
    return kind in KINDS_TYPE
}
