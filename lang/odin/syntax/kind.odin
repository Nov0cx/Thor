package odinsyntax

// The kind of a syntax node.
Syntax_Kind :: enum u16 {
    None, // no node; a parse procedure that built nothing returns it
    Root,
    Error, // tokens no rule absorbs

    File_Tag,
    Package_Decl,
    Import_Decl,
    Foreign_Import_Decl,
    Foreign_Block,
    Value_Decl,
    Attribute,
    Name_List,
    Expr_List,

    Block,
    Do_Body, // `do` and the one statement after it
    Expr_Stmt,
    Assign_Stmt,
    If_Stmt,
    When_Stmt,
    For_Stmt,
    Range_Stmt,
    Switch_Stmt,
    Type_Switch_Stmt,
    Case_Clause,
    Return_Stmt,
    Defer_Stmt,
    Branch_Stmt,
    Using_Stmt,
    Label,

    Ident,
    Literal,
    Context_Expr,
    Undef_Expr,
    Comp_Lit,
    Field_Value,
    Paren_Expr,
    Selector_Expr,
    Implicit_Selector,
    Selector_Call_Expr,
    Index_Expr,
    Matrix_Index_Expr,
    Slice_Expr,
    Deref_Expr,
    Call_Expr,
    Arg_List,
    Spread_Expr, // `..x` in an argument list
    Unary_Expr,
    Binary_Expr,
    Ternary_Expr, // `c ? x : y`
    Ternary_If_Expr,
    Ternary_When_Expr,
    Or_Else_Expr,
    Or_Return_Expr,
    Or_Branch_Expr,
    Type_Assertion,
    Cast_Expr,
    Auto_Cast_Expr,
    Proc_Lit,
    Proc_Group,
    Directive, // `#name`
    Tag_Expr,  // a directive and the expression or type it applies to
    Helper_Type,

    Proc_Type,
    Param_List,
    Result_List,
    Field_List,
    Field,
    Ellipsis_Type, // `..T` of a variadic parameter
    Where_Clause,
    Struct_Type,
    Union_Type,
    Enum_Type,
    Bit_Set_Type,
    Bit_Field_Type,
    Bit_Field_Field,
    Map_Type,
    Matrix_Type,
    Array_Type,
    Dynamic_Array_Type,
    Pointer_Type,
    Multi_Pointer_Type,
    Poly_Type,
    Typeid_Type,
    Distinct_Type,

    Asm_Template,
    Asm_Group,
    Asm_Spec_List,
    Asm_Spec,
    Asm_Clobber,
    Asm_Body,
    Asm_Instruction,
    Asm_Label_Decl,
    Asm_Label,
    Asm_Directive,
    Asm_Register,
    Asm_Memory_Operand,
    Asm_Register_Group,
}
